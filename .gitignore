# Build outputs
android/.gradle/
android/build/
android/app/build/
android/*/build/
android/local.properties
windows/build/
windows/dist/
windows/__pycache__/
windows/*.spec
__pycache__/

# Installers and packaged builds: these are attached to the GitHub Release
# instead of being committed (a release asset download is the normal way to
# hand somebody an APK, and it keeps the clone small).
dist/

# PyInstaller onedir output (produced by build_windows.ps1 into windows/dist,
# but sometimes copied to the repository root while testing)
/_internal/
/LiteChat.exe
/Uninstall.exe

# Signing material — never commit a keystore or its passwords
signing/*.jks
signing/*.keystore
signing/*.properties

# Windows installer scratch copy (regenerated by build_windows.ps1)
windows/installer/_LiteChat.generated.nsi
windows/installer/LiteChat-Setup-*.exe

# Generated icon (regenerated by tools/make_icon.py)
windows/assets/

# Build distribution binaries (use GitHub Releases instead)
dist/
